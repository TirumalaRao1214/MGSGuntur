@using MarwadiGheeSweetsWeb.Configuration
@using Microsoft.Extensions.Options
@inject IOptions<ShopSettings> ShopOptions
@{
    ViewBag.Title = "Your Cart";
    var settings = ShopOptions.Value;
}

<nav class="page-breadcrumb" aria-label="Breadcrumb">
    <div class="container">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Home</a></li>
            <li class="breadcrumb-item active">Cart</li>
        </ol>
    </div>
</nav>

<section class="py-5">
    <div class="container">
        <h1 style="font-family:var(--font-serif);font-size:2rem;font-weight:800;color:var(--text-dark);margin-bottom:32px;">
            Your Cart 🛒
        </h1>

        <div class="row g-4">
            <!-- Cart Items -->
            <div class="col-lg-8">
                <div id="cart-items-container">
                    <!-- Rendered by JS -->
                </div>
                <div id="cart-empty" style="display:none;text-align:center;padding:60px 20px;">
                    <div style="font-size:64px;margin-bottom:16px;">🛒</div>
                    <h2 style="font-family:var(--font-serif);color:var(--text-dark);">Your cart is empty</h2>
                    <p style="color:var(--text-muted);margin-bottom:24px;">Explore our range of fresh, authentic sweets!</p>
                    <a href="/sweets" class="btn-primary-brand">Browse All Sweets</a>
                </div>
            </div>

            <!-- Order Summary -->
            <div class="col-lg-4">
                <div class="cart-summary-box" id="cart-summary">
                    <h3 style="font-family:var(--font-serif);font-size:1.2rem;font-weight:700;margin-bottom:20px;">Order Summary</h3>

                    <div id="free-shipping-info" class="free-shipping-bar mb-3" style="display:none;"></div>

                    <div class="cart-summary-row">
                        <span>Subtotal</span>
                        <span id="summary-subtotal">₹0</span>
                    </div>
                    <div class="cart-summary-row">
                        <span>Delivery</span>
                        <span id="summary-delivery">₹@settings.DeliveryCharge</span>
                    </div>
                    <div class="cart-total-row">
                        <span>Total</span>
                        <span id="summary-total" style="color:var(--burgundy);">₹0</span>
                    </div>

                    <a href="/Checkout" id="checkout-btn"
                       class="btn-primary-brand mt-4" style="width:100%;justify-content:center;font-size:15px;">
                        Proceed to Checkout 📲
                    </a>
                    <a href="/sweets" class="btn-outline-brand mt-2" style="width:100%;justify-content:center;font-size:13px;">
                        Continue Shopping
                    </a>

                    <!-- Trust badges -->
                    <div style="border-top:1px solid var(--border);margin-top:20px;padding-top:16px;">
                        <div style="font-size:12px;color:var(--text-muted);text-align:center;line-height:2;">
                            🔒 Secure WhatsApp Checkout<br>
                            🚚 Free delivery above ₹@settings.FreeShippingThreshold<br>
                            📞 @settings.Phone
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
<script>
const FREE_THRESHOLD  = @settings.FreeShippingThreshold;
const DELIVERY_CHARGE = @settings.DeliveryCharge;

function renderCartPage() {
    const items    = Cart.get();
    const container = document.getElementById('cart-items-container');
    const emptyDiv  = document.getElementById('cart-empty');
    const summaryDiv = document.getElementById('cart-summary');

    if (items.length === 0) {
        container.innerHTML = '';
        emptyDiv.style.display  = 'block';
        summaryDiv.style.display = 'none';
        return;
    }

    emptyDiv.style.display   = 'none';
    summaryDiv.style.display = 'block';

    container.innerHTML = items.map(item => `
        <div class="cart-item-row" data-key="${item._key}">
            <img src="${item.imageUrl || '/images/placeholder-sweet.svg'}" alt="${item.productName}" class="cart-item-img"
                 onerror="this.src='/images/placeholder-sweet.svg'">
            <div style="flex:1;min-width:0;">
                <a href="/sweets/${item.productSlug}" style="font-weight:700;font-size:15px;color:var(--text-dark);text-decoration:none;">${item.productName}</a>
                <div style="font-size:12px;color:var(--gold);margin:2px 0;">${item.weightLabel}</div>
                <div style="font-size:14px;font-weight:600;color:var(--text-muted);">₹${item.price.toFixed(0)} each</div>
            </div>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:8px;">
                <button onclick="Cart.remove('${item._key}');renderCartPage();"
                    style="background:none;border:none;color:var(--text-muted);font-size:18px;cursor:pointer;padding:0;" aria-label="Remove item">
                    <i class="bi bi-trash3"></i>
                </button>
                <div style="font-family:var(--font-serif);font-weight:700;font-size:16px;color:var(--burgundy);">
                    ₹${(item.price * item.quantity).toFixed(0)}
                </div>
                <div class="qty-control">
                    <button class="qty-btn" onclick="Cart.updateQty('${item._key}',-1);renderCartPage();" aria-label="Decrease">−</button>
                    <input type="number" value="${item.quantity}" min="1" class="qty-display"
                           onchange="Cart.setQty('${item._key}',this.value);renderCartPage();" aria-label="Quantity">
                    <button class="qty-btn" onclick="Cart.updateQty('${item._key}',1);renderCartPage();" aria-label="Increase">+</button>
                </div>
            </div>
        </div>`).join('');

    // Summary
    const sub      = Cart.subtotal();
    const delivery = Cart.deliveryCharge(FREE_THRESHOLD, DELIVERY_CHARGE);
    const total    = sub + delivery;
    document.getElementById('summary-subtotal').textContent = '₹' + sub.toFixed(0);
    document.getElementById('summary-delivery').innerHTML   = delivery > 0
        ? '₹' + delivery.toFixed(0)
        : '<span style="color:green;font-weight:700;">FREE</span>';
    document.getElementById('summary-total').textContent = '₹' + total.toFixed(0);

    const remaining = FREE_THRESHOLD - sub;
    const fsInfo    = document.getElementById('free-shipping-info');
    fsInfo.style.display = 'block';
    fsInfo.innerHTML = remaining > 0
        ? `Add <strong>₹${remaining.toFixed(0)}</strong> more for FREE delivery
           <div class="free-shipping-track"><div class="free-shipping-progress" style="width:${Math.min(100,(sub/FREE_THRESHOLD)*100).toFixed(0)}%"></div></div>`
        : `🎉 You've unlocked <strong>FREE delivery!</strong>`;
}

document.addEventListener('DOMContentLoaded', renderCartPage);
window.addEventListener('cart:changed', renderCartPage);
</script>
}

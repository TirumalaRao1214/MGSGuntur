@model MarwadiGheeSweetsWeb.ViewModels.AdminProductViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.PageTitle = Model.IsEdit ? $"Edit: {Model.Name}" : "Add Product";
    var maxWeights = 4;
    // Pad weight lists to maxWeights
    while (Model.WeightLabels.Count   < maxWeights) Model.WeightLabels.Add("");
    while (Model.WeightPrices.Count   < maxWeights) Model.WeightPrices.Add(0);
    while (Model.WeightOriginals.Count< maxWeights) Model.WeightOriginals.Add(null);
    while (Model.WeightAvailable.Count< maxWeights) Model.WeightAvailable.Add(true);
}

<div class="d-flex align-items-center gap-2 mb-3">
    <a href="/admin/products" style="color:#6b7280;font-size:13px;"><i class="bi bi-arrow-left"></i> Back to Products</a>
</div>

<form asp-action="@(Model.IsEdit ? "EditProduct" : "CreateProduct")"
      asp-route-id="@Model.Id"
      method="post"
      enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />

    <div class="row g-3">

        <!-- Left column -->
        <div class="col-lg-8">
            <div class="form-card mb-3">
                <div class="section-title">Basic Info</div>
                <div class="row g-3">
                    <div class="col-md-8">
                        <label asp-for="Name" class="form-label">Product Name *</label>
                        <input asp-for="Name" class="form-control" placeholder="e.g. Ghee Mysore Pak" />
                        <span asp-validation-for="Name" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Slug" class="form-label">URL Slug *</label>
                        <input asp-for="Slug" class="form-control" placeholder="e.g. ghee-mysore-pak" id="slug-field" />
                        <span asp-validation-for="Slug" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="ShortDescription" class="form-label">Short Description *</label>
                        <input asp-for="ShortDescription" class="form-control" placeholder="One-line description shown on cards" />
                        <span asp-validation-for="ShortDescription" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">Full Description</label>
                        <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed product description"></textarea>
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Pricing & Weights</div>
                <div class="row g-2 mb-2">
                    <div class="col-3"><small class="text-muted fw-bold">Label</small></div>
                    <div class="col-3"><small class="text-muted fw-bold">Price (₹)</small></div>
                    <div class="col-3"><small class="text-muted fw-bold">Original (₹)</small></div>
                    <div class="col-3"><small class="text-muted fw-bold">Available</small></div>
                </div>
                @for (int i = 0; i < maxWeights; i++)
                {
                    <div class="row g-2 mb-2">
                        <div class="col-3">
                            <input name="WeightLabels[@i]" value="@Model.WeightLabels[i]" class="form-control form-control-sm" placeholder="250g" />
                        </div>
                        <div class="col-3">
                            <input name="WeightPrices[@i]" value="@Model.WeightPrices[i]" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="0" />
                        </div>
                        <div class="col-3">
                            <input name="WeightOriginals[@i]" value="@(Model.WeightOriginals[i]?.ToString() ?? "")" type="number" step="0.01" min="0" class="form-control form-control-sm" placeholder="—" />
                        </div>
                        <div class="col-3 d-flex align-items-center">
                            <input name="WeightAvailable[@i]" type="checkbox" class="form-check-input" value="true"
                                   @(Model.WeightAvailable[i] ? "checked" : "") style="width:18px;height:18px;" />
                        </div>
                    </div>
                }
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Ingredients & Storage</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="IngredientsText" class="form-label">Ingredients <small class="text-muted fw-normal">(comma-separated)</small></label>
                        <input asp-for="IngredientsText" class="form-control" placeholder="Pure Ghee, Besan, Sugar, Cardamom" />
                    </div>
                    <div class="col-12">
                        <label asp-for="AllergensText" class="form-label">Allergens <small class="text-muted fw-normal">(comma-separated)</small></label>
                        <input asp-for="AllergensText" class="form-control" placeholder="Contains Dairy, Contains Nuts" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ShelfLife" class="form-label">Shelf Life</label>
                        <input asp-for="ShelfLife" class="form-control" placeholder="7–10 days at room temperature" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StorageInstructions" class="form-label">Storage Instructions</label>
                        <input asp-for="StorageInstructions" class="form-control" placeholder="Store in a cool dry place" />
                    </div>
                </div>
            </div>
        </div>

        <!-- Right column -->
        <div class="col-lg-4">
            <div class="form-card mb-3">
                <div class="section-title">Category</div>
                <div class="mb-3">
                    <label class="form-label">Category *</label>
                    <select class="form-select" id="cat-select" onchange="onCatChange(this)">
                        @foreach (var cat in Model.AllCategories)
                        {
                            <option value="@cat.Name|@cat.Slug" selected="@(cat.Slug == Model.CategorySlug ? "selected" : null)">
                                @cat.Icon @cat.Name
                            </option>
                        }
                    </select>
                    <input type="hidden" asp-for="Category"     id="cat-name" />
                    <input type="hidden" asp-for="CategorySlug" id="cat-slug" />
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Images</div>

                @* Upload area *@
                <div id="upload-area"
                     style="border:2px dashed #d1d5db;border-radius:8px;padding:18px 12px;text-align:center;cursor:pointer;margin-bottom:10px;transition:border-color .2s;"
                     onclick="document.getElementById('img-file-input').click()"
                     ondragover="event.preventDefault();this.style.borderColor='#800020';"
                     ondragleave="this.style.borderColor='#d1d5db';"
                     ondrop="handleImgDrop(event)">
                    <div id="upload-preview-wrap" style="display:none;margin-bottom:8px;">
                        <img id="upload-preview" src="" alt="Preview"
                             style="max-width:100%;max-height:140px;border-radius:6px;object-fit:cover;" />
                    </div>
                    <div id="upload-placeholder">
                        <i class="bi bi-cloud-arrow-up" style="font-size:22px;color:#9ca3af;"></i>
                        <div style="font-size:12px;color:#6b7280;margin-top:4px;">Click or drag &amp; drop an image to upload</div>
                        <div style="font-size:11px;color:#9ca3af;">JPG, PNG, WebP — max 5 MB</div>
                    </div>
                    <input type="file" id="img-file-input" name="ImageUpload"
                           accept="image/jpeg,image/png,image/webp,image/gif"
                           style="display:none;" onchange="handleImgSelect(this)" />
                </div>

                @* Fallback: manual URL / path entry *@
                <label asp-for="Images" class="form-label" style="margin-top:4px;">
                    Or enter image URL / path <small class="text-muted fw-normal">(one per line)</small>
                </label>
                <textarea asp-for="Images" id="images-textarea" class="form-control" rows="3"
                          placeholder="https://… or /images/products/ghee-mysore-pak.jpg"></textarea>
                <div style="font-size:11px;color:#9ca3af;margin-top:4px;">Uploading a file will replace the path above automatically.</div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Ratings & Sort</div>
                <div class="row g-2">
                    <div class="col-6">
                        <label asp-for="Rating" class="form-label">Rating (0–5)</label>
                        <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label asp-for="ReviewCount" class="form-label">Review Count</label>
                        <input asp-for="ReviewCount" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label asp-for="SortOrder" class="form-label">Sort Order</label>
                        <input asp-for="SortOrder" type="number" min="0" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label asp-for="Badge" class="form-label">Badge</label>
                        <input asp-for="Badge" class="form-control" placeholder="Best Seller" />
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Flags</div>
                <div class="d-flex flex-column gap-2">
                    @foreach (var (field, label, icon) in new[]{
                        ("IsAvailable",  "Available (visible in shop)", "bi-check-circle"),
                        ("IsBestSeller", "Best Seller",                  "bi-star-fill"),
                        ("IsFeatured",   "Featured",                     "bi-lightning-fill"),
                        ("IsNew",        "New Arrival",                  "bi-sparkles"),
                        ("IsGiftItem",   "Gift Item",                    "bi-gift-fill"),
                    })
                    {
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="@field" value="true" id="flag-@field"
                                   @(field switch {
                                       "IsAvailable"  => Model.IsAvailable  ? "checked" : "",
                                       "IsBestSeller" => Model.IsBestSeller ? "checked" : "",
                                       "IsFeatured"   => Model.IsFeatured   ? "checked" : "",
                                       "IsNew"        => Model.IsNew        ? "checked" : "",
                                       "IsGiftItem"   => Model.IsGiftItem   ? "checked" : "",
                                       _              => ""
                                   }) />
                            <label class="form-check-label" for="flag-@field" style="font-size:13px;">
                                <i class="bi @icon" style="font-size:11px;"></i> @label
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn" style="background:#800020;color:white;padding:11px;font-weight:700;">
                    <i class="bi bi-floppy-fill"></i> @(Model.IsEdit ? "Save Changes" : "Create Product")
                </button>
                <a href="/admin/products" class="btn" style="border:1px solid #e5e7eb;color:#6b7280;">Cancel</a>
            </div>
        </div>

    </div>
</form>

@section Scripts {
<script>
// ── Slug auto-generate ─────────────────────────────────────────────────
const slugField = document.getElementById('slug-field');
const isEdit    = @(Model.IsEdit ? "true" : "false");
if (!isEdit) {
    document.querySelector('[name="Name"]').addEventListener('input', function () {
        slugField.value = this.value.toLowerCase().trim()
            .replace(/[^a-z0-9\s-]/g, '').replace(/\s+/g, '-').replace(/-+/g, '-');
    });
}

// ── Category sync ──────────────────────────────────────────────────────
function onCatChange(sel) {
    const parts = sel.value.split('|');
    document.getElementById('cat-name').value = parts[0];
    document.getElementById('cat-slug').value = parts[1];
}
(function() {
    const sel = document.getElementById('cat-select');
    if (sel) onCatChange(sel);
})();

// ── Image upload preview ───────────────────────────────────────────────
function showPreview(file) {
    if (!file || !file.type.startsWith('image/')) return;
    if (file.size > 5 * 1024 * 1024) {
        alert('File is larger than 5 MB. Please choose a smaller image.');
        return;
    }
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('upload-preview').src = e.target.result;
        document.getElementById('upload-preview-wrap').style.display = 'block';
        document.getElementById('upload-placeholder').style.display  = 'none';
        document.getElementById('upload-area').style.borderColor     = '#800020';
    };
    reader.readAsDataURL(file);
}

function handleImgSelect(input) {
    if (input.files && input.files[0]) showPreview(input.files[0]);
}

function handleImgDrop(e) {
    e.preventDefault();
    document.getElementById('upload-area').style.borderColor = '#d1d5db';
    const file = e.dataTransfer.files && e.dataTransfer.files[0];
    if (!file) return;
    // Inject file into the hidden input via DataTransfer
    const dt = new DataTransfer();
    dt.items.add(file);
    const inp = document.getElementById('img-file-input');
    inp.files = dt.files;
    showPreview(file);
}

// Show existing image as preview on edit
(function() {
    const ta = document.getElementById('images-textarea');
    if (!ta) return;
    const firstLine = ta.value.split('\n').map(s => s.trim()).find(s => s.length > 0);
    if (firstLine) {
        document.getElementById('upload-preview').src               = firstLine;
        document.getElementById('upload-preview-wrap').style.display = 'block';
        document.getElementById('upload-placeholder').style.display  = 'none';
    }
})();
</script>
}

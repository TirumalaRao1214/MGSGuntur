@model MarwadiGheeSweetsWeb.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewBag.Title = "Sign In";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — Marwadi Ghee Sweets</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.min.css" asp-append-version="true" />
    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #1a0a05 0%, #800020 50%, #b8860b 100%);
            display: flex; align-items: center; justify-content: center;
            font-family: -apple-system, "Segoe UI", sans-serif;
        }
        .login-card {
            background: white; border-radius: 16px;
            padding: 40px 36px; width: 100%; max-width: 400px;
            box-shadow: 0 24px 64px rgba(0,0,0,.4);
        }
        .login-logo { text-align: center; margin-bottom: 28px; }
        .login-logo .icon { font-size: 40px; }
        .login-logo .brand { font-size: 18px; font-weight: 800; color: #1a0a05; margin-top: 6px; }
        .login-logo .sub   { font-size: 12px; color: #9ca3af; }
        .form-label { font-weight: 600; font-size: 13px; color: #374151; }
        .form-control { border-radius: 8px; padding: 10px 14px; border: 1px solid #d1d5db; font-size: 14px; }
        .form-control:focus { border-color: #800020; box-shadow: 0 0 0 3px rgba(128,0,32,.12); }
        .btn-signin {
            background: #800020; color: white; border: none;
            border-radius: 8px; padding: 11px; font-weight: 700; font-size: 15px;
            width: 100%; transition: background .2s;
        }
        .btn-signin:hover { background: #5c0011; color: white; }
        .back-link { text-align: center; margin-top: 16px; font-size: 13px; }
        .back-link a { color: #800020; }
    </style>
</head>
<body>
<div class="login-card">
    <div class="login-logo">
        <div class="icon">🍬</div>
        <div class="brand">Marwadi Ghee Sweets</div>
        <div class="sub">Management Portal</div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Error))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 py-2 mb-3" style="font-size:13px;">
            <i class="bi bi-exclamation-triangle-fill"></i> @Model.Error
        </div>
    }

    <form asp-controller="Auth" asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
            <label asp-for="Username" class="form-label">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Enter username" autocomplete="username" autofocus />
            <span asp-validation-for="Username" class="text-danger" style="font-size:12px;"></span>
        </div>

        <div class="mb-4">
            <label asp-for="Password" class="form-label">Password</label>
            <input asp-for="Password" class="form-control" placeholder="Enter password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="text-danger" style="font-size:12px;"></span>
        </div>

        <button type="submit" class="btn-signin">
            <i class="bi bi-box-arrow-in-right"></i> Sign In
        </button>
    </form>

    <div class="back-link">
        <a href="/"><i class="bi bi-arrow-left"></i> Back to Store</a>
    </div>
</div>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>

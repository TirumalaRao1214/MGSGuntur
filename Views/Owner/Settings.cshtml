@model MarwadiGheeSweetsWeb.ViewModels.OwnerSettingsViewModel
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.PageTitle = "Shop Settings";
}

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-check-circle-fill"></i> @Model.SuccessMessage
    </div>
}

<form asp-controller="Owner" asp-action="Settings" method="post">
    @Html.AntiForgeryToken()

    <div class="row g-3">
        <div class="col-lg-8">

            <div class="form-card mb-3">
                <div class="section-title">Shop Identity</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="ShopName" class="form-label">Shop Name *</label>
                        <input asp-for="ShopName" class="form-control" />
                        <span asp-validation-for="ShopName" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TagLine" class="form-label">Tagline *</label>
                        <input asp-for="TagLine" class="form-control" />
                        <span asp-validation-for="TagLine" class="text-danger" style="font-size:12px;"></span>
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Contact & Ordering</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="WhatsAppNumber" class="form-label">WhatsApp Number * <small class="text-muted fw-normal">(country code, no +)</small></label>
                        <input asp-for="WhatsAppNumber" class="form-control" placeholder="919000037265" />
                        <span asp-validation-for="WhatsAppNumber" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Phone" class="form-label">Display Phone *</label>
                        <input asp-for="Phone" class="form-control" placeholder="+91 90000 37265" />
                        <span asp-validation-for="Phone" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" type="email" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Store Address</div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Address" class="form-label">Full Address *</label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger" style="font-size:12px;"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="City" class="form-label">City *</label>
                        <input asp-for="City" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="State" class="form-label">State</label>
                        <input asp-for="State" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PinCode" class="form-label">Pin Code</label>
                        <input asp-for="PinCode" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="StoreHours" class="form-label">Store Hours</label>
                        <input asp-for="StoreHours" class="form-control" placeholder="10:00 AM – 10:00 PM (Daily)" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="GoogleMapsUrl" class="form-label">Google Maps URL</label>
                        <input asp-for="GoogleMapsUrl" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Social Media</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="InstagramUrl" class="form-label">Instagram URL</label>
                        <input asp-for="InstagramUrl" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="FacebookUrl" class="form-label">Facebook URL</label>
                        <input asp-for="FacebookUrl" class="form-control" />
                    </div>
                </div>
            </div>

        </div>

        <div class="col-lg-4">
            <div class="form-card mb-3">
                <div class="section-title">Delivery & Pricing</div>
                <div class="mb-3">
                    <label asp-for="FreeShippingThreshold" class="form-label">Free Delivery above (₹)</label>
                    <input asp-for="FreeShippingThreshold" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="FreeShippingThreshold" class="text-danger" style="font-size:12px;"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DeliveryCharge" class="form-label">Delivery Charge (₹)</label>
                    <input asp-for="DeliveryCharge" type="number" step="0.01" min="0" class="form-control" />
                    <span asp-validation-for="DeliveryCharge" class="text-danger" style="font-size:12px;"></span>
                </div>
            </div>

            <div class="form-card mb-3">
                <div class="section-title">Google Rating</div>
                <div class="mb-3">
                    <label asp-for="Rating" class="form-label">Average Rating (0–5)</label>
                    <input asp-for="Rating" type="number" step="0.1" min="0" max="5" class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for="ReviewCount" class="form-label">Total Reviews</label>
                    <input asp-for="ReviewCount" type="number" min="0" class="form-control" />
                </div>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn" style="background:#800020;color:white;padding:11px;font-weight:700;">
                    <i class="bi bi-floppy-fill"></i> Save Settings
                </button>
                <a href="/owner" class="btn" style="border:1px solid #e5e7eb;color:#6b7280;">Cancel</a>
            </div>

            <div class="mt-3 p-3" style="background:#fffbeb;border:1px solid #fcd34d;border-radius:8px;font-size:12px;color:#92400e;">
                <i class="bi bi-info-circle-fill"></i>
                Settings are saved to <code>appsettings.json</code>. WhatsApp links and phone numbers update immediately on next page load. A full app restart applies rating/review changes.
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
